<main class="konten">
  <div class="judul-halaman">
    <h1>Proyek Saya</h1>
    <a href="?page=pasang-proyek" class="btn">Pasang Proyek</a>
  </div>

  <?php if ($pesan): ?>
    <div class="pesan-sukses" role="status"><?= h($pesan) ?></div>
  <?php endif; ?>

  <section class="kartu">
    <?php if (empty($proyek)): ?>
      <div class="kosong">
        <p>Anda belum memasang proyek.</p>
        <a href="?page=pasang-proyek" class="btn">Pasang Proyek</a>
      </div>
    <?php else: ?>
      <div class="tabel-bungkus">
        <table>
          <thead>
            <tr>
              <th>Judul</th>
              <th>Status</th>
              <th>Budget</th>
              <th>Batas Lelang</th>
              <th class="angka">Penawaran</th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($proyek as $p): ?>
              <tr>
                <td><a class="judul-proyek" href="?page=detail-proyek&amp;id=<?= (int) $p['id'] ?>"><?= h($p['judul']) ?></a></td>
                <td><span class="status <?= h($p['status']) ?>"><?= h(ucfirst($p['status'])) ?></span></td>
                <td><?= rupiah($p['budget_min']) ?> – <?= rupiah($p['budget_maks']) ?></td>
                <td><?= h(date('d/m/Y', strtotime($p['batas_lelang']))) ?></td>
                <td class="angka"><?= (int) $p['jumlah_penawaran'] ?></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>
  </section>
</main>

