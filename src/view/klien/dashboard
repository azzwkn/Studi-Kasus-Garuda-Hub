<?php
// src/view/klien/dashboard.php
// Data $proyek disiapkan dari database (hanya proyek milik klien yang login).
// Kolom yang dipakai: id, judul, status, budget_min, budget_maks, batas_lelang, jumlah_penawaran
// Sesuaikan nama kolom dan nilai ?page= dengan proyekmu.

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

$proyek = $proyek ?? [];
$namaKlien = $_SESSION['nama'] ?? 'Klien';

$pesan = $_SESSION['sukses'] ?? null;
unset($_SESSION['sukses']);

function h($teks) { return htmlspecialchars((string) $teks, ENT_QUOTES, 'UTF-8'); }
function rupiah($angka) { return 'Rp ' . number_format((int) $angka, 0, ',', '.'); }
?>
