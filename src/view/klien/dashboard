    </nav>

    <div class="pengguna">
      <div class="avatar"><?= h(strtoupper(substr($namaKlien, 0, 1))) ?></div>
      <div><strong><?= h($namaKlien) ?></strong><span>Klien</span></div>
    </div>
  </div>
